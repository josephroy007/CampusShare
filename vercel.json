{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd CampusShare && pip install -r requirements.txt && python3 -m reflex export --frontend-only",
  "outputDirectory": "CampusShare/.web/build/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/items/(.*)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
